  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "postinstall": "node -e \"import('fs').then(fs => { const p='node_modules/vite/dist/client/client.mjs'; if (fs.existsSync(p)) { let c = fs.readFileSync(p, 'utf8'); if (!c.includes('typeof ws.send')) { c = c.replace('ws.send(JSON.stringify(data));', 'if (ws && typeof ws.send === \\'function\\') { ws.send(JSON.stringify(data)); }'); fs.writeFileSync(p, c); } } });\""
  },
